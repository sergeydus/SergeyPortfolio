{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npm run build && npm run smoke:stage && node scripts/serve-smoke.mjs",
    "audit:policy": "npm audit --audit-level=high",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "smoke:stage": "node scripts/stage-smoke.mjs",
    "smoke": "npm run smoke:stage && node scripts/run-smoke.mjs",
    "verify": "npm run audit:policy && npm run lint && npm run typecheck && npm run build && npm run smoke"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "18.3.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "18.3.7",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.3.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
